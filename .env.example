DATABASE_URL=postgresql+psycopg://dev_user:change-me@localhost:5432/fastapi_dev

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
SESSION_SECRET_KEY=replace-with-a-different-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_SECONDS=28800

# Use false only for local HTTP development. Keep true behind HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_SUCCESS_REDIRECT_URL=http://localhost:8000/